# Public HTTPS address of the deployed web app (used in docs/links).
SITE_URL=https://your-domain.example

# Directory for db.json. Must be a persistent disk in production.
DATA_DIR=/var/data

# Demo profiles that auto-like / auto-reply. Must stay "false" for the Play Store build.
DEMO_MODE=false

# Operator account created on start-up (no default admin exists in production).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Shown on /privacy, /terms, /child-safety and /account-deletion.
SUPPORT_EMAIL=
CHILD_SAFETY_EMAIL=
PRIVACY_OFFICER=
OPERATOR_NAME=

# Trusted Web Activity: served at /.well-known/assetlinks.json
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_CERT_FINGERPRINTS=
